{
  "name": "todo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch dev-server.js\" \"vite\"",
    "build": "tsc --noEmit && vite build",
